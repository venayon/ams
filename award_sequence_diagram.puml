@startuml AwardService_Sequence

!theme plain

skinparam backgroundColor #1a1a2e
skinparam sequenceArrowColor #00d4ff
skinparam sequenceArrowThickness 2

skinparam participant {
    BackgroundColor #0f3460
    BorderColor #00d4ff
    FontColor #e0e0e0
    FontName "Courier New"
    FontSize 13
}

skinparam note {
    BackgroundColor #16213e
    BorderColor #e94560
    FontColor #e0e0e0
    FontName "Courier New"
}

skinparam sequence {
    LifeLineBorderColor #00d4ff
    LifeLineBackgroundColor #0f3460
    GroupBorderColor #e94560
    GroupFontColor #e94560
    GroupBackgroundColor #16213e
    DividerBackgroundColor #16213e
    DividerBorderColor #00d4ff
    DividerFontColor #00d4ff
    BoxBorderColor #00d4ff
    BoxFontColor #00d4ff
    BoxBackgroundColor #16213e
    ArrowFontColor #a0a0c0
    ArrowFontName "Courier New"
}

skinparam shadowing false
skinparam roundCorner 6

title <color:#00d4ff><size:16>Award Service — Proxy + Facade Pattern Flow</size></color>

participant "ServiceLayer\n(AwardService)" as SL
participant "PROXY PATTERN\n(AwardRepoProxy)" as PROXY
participant "FACADE PATTERN\n(AwardFacade)" as FACADE
participant "OldFlow\n(Repository)" as OLD
participant "NewFlow\n(Repository)" as NEW
database   "MongoDB\nDatabase" as DB

== Save Award Request ==

SL -> PROXY : save(award)\n<color:#a0a0c0>//calls OldFlow interface//</color>

activate PROXY

note over PROXY #0f3460
  <color:#00d4ff>Cross-Cutting Concerns</color>
  • Validates award
  • Logs operation
  • Handles errors
end note

PROXY -> PROXY : validate(award)
PROXY -> PROXY : log("save operation")

alt <color:#e94560>Validation Failed</color>
    PROXY --> SL : <color:#e94560>throw ValidationException</color>
end

PROXY -> FACADE : delegate(award)\n<color:#a0a0c0>//delegates to//</color>

activate FACADE

note over FACADE #0f3460
  <color:#00d4ff>Business Routing</color>
  • Checks feature toggle
  • Decides: OldFlow or NewFlow?
  • Routes to correct repository
end note

FACADE -> FACADE : checkFeatureToggle()

alt <color:#a0ffa0>Toggle OFF — OldFlow</color>
    FACADE -> OLD : save(award)
    activate OLD
    OLD -> DB : insert/update document
    activate DB
    DB --> OLD : <color:#a0ffa0>success</color>
    deactivate DB
    OLD --> FACADE : <color:#a0ffa0>AwardEntity</color>
    deactivate OLD

else <color:#ffd700>Toggle ON — NewFlow</color>
    FACADE -> NEW : save(award)
    activate NEW
    NEW -> DB : insert/update document
    activate DB
    DB --> NEW : <color:#a0ffa0>success</color>
    deactivate DB
    NEW --> FACADE : <color:#a0ffa0>AwardEntity</color>
    deactivate NEW
end

FACADE --> PROXY : <color:#a0ffa0>AwardEntity</color>
deactivate FACADE

PROXY -> PROXY : log("save completed")
PROXY --> SL : <color:#a0ffa0>AwardEntity</color>
deactivate PROXY

@enduml
